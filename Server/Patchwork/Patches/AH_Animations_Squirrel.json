  "Targets": [
    "Server/Models/Critter/Squirrel.json"
  ],
  "When": {
    "TargetExists": true
  },
  "Priority": 0,
  "Enabled": true,
  "Operations": [
    {
      "Id": "add-animation-sets",
      "Op": "Merge",
      "Path": "",
      "Value": {
        "AnimationSets": {
          "Curious": {
            "Animations": [
              {
                "Animation": "NPC/Critter/Squirrel/Animations/Flavor/Look_Around.blockyanim"
              }
            ]
          },
          "TurnLeft": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Squirrel/Animations/Turn_Left.blockyanim"
              }
            ]
          },
          "TurnRight": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Squirrel/Animations/Turn_Right.blockyanim"
              }
            ]
          }
        }
      }
    }
  ]
}
