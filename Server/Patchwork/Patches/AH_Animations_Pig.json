{
  "Id": "AH_Animations_Pig",
  "$Comment": "Wires the base game's unused Pig turn-in-place clips as TurnLeft and TurnRight. Tamework plays them while an idle NPC's body turns. Child models inherit them.",
  "Targets": [
    "Server/Models/Livestock/Pig.json"
  ],
  "When": {
    "TargetExists": true
  },
  "Priority": 0,
  "Enabled": true,
  "Operations": [
    {
      "Id": "add-animation-sets",
      "Op": "Merge",
      "Path": "",
      "Value": {
        "AnimationSets": {
          "TurnLeft": {
            "Animations": [
              {
                "Animation": "NPC/Livestock/Pig/Animations/Default/Turn_Left.blockyanim"
              }
            ]
          },
          "TurnRight": {
            "Animations": [
              {
                "Animation": "NPC/Livestock/Pig/Animations/Default/Turn_Right.blockyanim"
              }
            ]
          }
        }
      }
    }
  ]
}
