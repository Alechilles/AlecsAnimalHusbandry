{
  "Id": "AH_Animations_Cactee",
  "$Comment": "Adds Animal Husbandry's Eat, Laydown animation sets to the base-game Cactee model. Child models inherit it.",
  "Targets": [
    "Server/Models/Beast/Cactee.json"
  ],
  "When": {
    "TargetExists": true
  },
  "Priority": 0,
  "Enabled": true,
  "Operations": [
    {
      "Id": "add-animation-sets",
      "Op": "Merge",
      "Path": "",
      "Value": {
        "AnimationSets": {
          "Eat": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Cactee/Animations/Eat.blockyanim"
              }
            ]
          },
          "Laydown": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Cactee/Animations/Laydown.blockyanim",
                "Looping": false
              }
            ]
          }
        }
      }
    }
  ]
}
