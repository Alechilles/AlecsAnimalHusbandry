{
  "Id": "AH_Animations_Gecko",
  "$Comment": "Adds Animal Husbandry's Eat, Curious animation sets to the base-game Gecko model. Child models inherit it.",
  "Targets": [
    "Server/Models/Critter/Gecko.json"
  ],
  "When": {
    "TargetExists": true
  },
  "Priority": 0,
  "Enabled": true,
  "Operations": [
    {
      "Id": "add-animation-sets",
      "Op": "Merge",
      "Path": "",
      "Value": {
        "AnimationSets": {
          "Eat": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Gecko/Animations/Eat.blockyanim"
              }
            ]
          },
          "Curious": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Gecko/Animations/Curious.blockyanim"
              }
            ]
          },
          "TurnLeft": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Gecko/Animations/Turn_Left.blockyanim",
                "Speed": 2
              }
            ]
          },
          "TurnRight": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Gecko/Animations/Turn_Right.blockyanim",
                "Speed": 2
              }
            ]
          }
        }
      }
    }
  ]
}
