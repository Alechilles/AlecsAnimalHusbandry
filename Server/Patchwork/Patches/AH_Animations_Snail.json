              {
                "Animation": "NPC/Beast/Snail/Animations/Flavor/Look_Around.blockyanim"
              }
            ]
          },
          "TurnLeft": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Snail/Animations/Turn_Left.blockyanim"
              }
            ]
          },
          "TurnRight": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Snail/Animations/Turn_Right.blockyanim"
              }
            ]
          }
        }
      }
    }
  ]
}
