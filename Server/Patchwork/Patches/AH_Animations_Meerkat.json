{
  "Id": "AH_Animations_Meerkat",
  "$Comment": "Adds Animal Husbandry's Eat animation set to the base-game Meerkat model, and a Curious set that plays the base-game Idle_Stand clip. Child models inherit it.",
  "Targets": [
    "Server/Models/Critter/Meerkat.json"
  ],
  "When": {
    "TargetExists": true
  },
  "Priority": 0,
  "Enabled": true,
  "Operations": [
    {
      "Id": "add-animation-sets",
      "Op": "Merge",
      "Path": "",
      "Value": {
        "AnimationSets": {
          "Eat": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Meerkat/Animations/Eat.blockyanim"
              }
            ]
          },
          "Curious": {
            "Animations": [
              {
                "Animation": "NPC/Critter/Meerkat/Animations/Flavor/Idle_Stand.blockyanim"
              }
            ]
          },
          "TurnLeft": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Meerkat/Animations/Turn_Left.blockyanim"
              }
            ]
          },
          "TurnRight": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Meerkat/Animations/Turn_Right.blockyanim"
              }
            ]
          }
        }
      }
    }
  ]
}
