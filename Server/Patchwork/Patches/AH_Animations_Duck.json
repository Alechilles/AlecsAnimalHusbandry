{
  "Id": "AH_Animations_Duck",
  "$Comment": "Adds Animal Husbandry's Eat animation set to the base-game Duck model. Child models inherit it.",
  "Targets": [
    "Server/Models/Flying_Wildlife/Duck.json"
  ],
  "When": {
    "TargetExists": true
  },
  "Priority": 0,
  "Enabled": true,
  "Operations": [
    {
      "Id": "add-animation-sets",
      "Op": "Merge",
      "Path": "",
      "Value": {
        "AnimationSets": {
          "Eat": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Duck/Animations/Eat.blockyanim"
              }
            ]
          },
          "TurnLeft": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Duck/Animations/Turn_Left.blockyanim"
              }
            ]
          },
          "TurnRight": {
            "Animations": [
              {
                "Animation": "NPC/AnimalHusbandry/Duck/Animations/Turn_Right.blockyanim"
              }
            ]
          }
        }
      }
    }
  ]
}
